{
  "name": "@tervox/api",
  "version": "0.0.1",
  "private": true,
  "description": "Tervox Fastify API service (Stage 1: foundation only — health endpoint, env validation, error envelope, structured logging).",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "bash scripts/db-wait.sh && npm run db:migrate && node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "bash scripts/db-reset.sh",
    "db:up": "docker compose up -d postgres && bash scripts/db-wait.sh",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "@tervox/contracts": "*",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.36.4",
    "fastify": "5.2.1",
    "pino": "9.5.0",
    "pino-pretty": "11.3.0",
    "postgres": "^3.4.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/node": "22.13.0",
    "drizzle-kit": "^0.28.1",
    "tsx": "4.20.3",
    "typescript": "5.5.4",
    "vitest": "3.2.6"
  }
}
